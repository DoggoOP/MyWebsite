---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  date?: string;
  links?: { github?: string; paper?: string; demo?: string; };
  animation: string;
  coverImage?: string;
  coverStyle?: 'photo' | 'diagram';
}

const { title, description, tags = [], date, links, animation, coverImage, coverStyle } = Astro.props;
const year = date ? new Date(`${date}T00:00:00`).getFullYear() : null;
const linkList = [
  links?.github && { href: links.github, label: 'GitHub' },
  links?.paper && { href: links.paper, label: 'Paper' },
  links?.demo && { href: links.demo, label: animation === 'polymarket' ? 'Live dashboard' : 'Demo' },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout title={`${title} · Ethan Kong`} description={description} math={true}>
  <header class="project-hero" data-animation={animation}>
    <a href="/projects" class="back text-link">Projects</a>
    <h1 class="display hero-title">{title}</h1>
    <p class="hero-desc">{description}</p>
    <p class="hero-meta label">
      {year && <span>{year}</span>}
      {tags.length > 0 && <span>{tags.slice(0, 4).join(', ')}</span>}
      {linkList.map(l => <a class="text-link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
    </p>
  </header>

  <figure class:list={['hero-figure', coverStyle && `is-${coverStyle}`]}>
    {animation === 'polymarket'
      ? <iframe class="hero-dashboard" src="https://polymarketdashboard-production.up.railway.app/" title="Polymarket live dashboard" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      : coverImage
        ? <img class="hero-image" src={coverImage} alt={`${title}`} />
        : <canvas id="hero-canvas" class="hero-canvas" aria-label={`${title} animated rendering`}></canvas>}
  </figure>

  <article class="project-content prose"><slot /></article>
</BaseLayout>

<style>
  .project-hero {
    max-width: 760px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + var(--s8)) var(--s6) var(--s7);
  }
  .back {
    display: inline-block;
    margin-bottom: var(--s6);
    color: var(--text-muted) !important;
    font-size: 14px;
  }
  .back::before { content: '← '; }
  .hero-title {
    font-size: 44px;
    margin-bottom: var(--s4);
  }
  .hero-desc {
    color: var(--text-secondary);
    font-size: 19px;
    line-height: 1.55;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    margin-top: var(--s5);
    color: var(--text-muted);
  }

  .hero-figure {
    max-width: 1080px;
    height: min(62vh, 600px);
    margin: var(--s4) auto 0;
    padding: 0 var(--s6);
  }
  .hero-image, .hero-canvas, .hero-dashboard {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-card);
    background: var(--bg-card);
  }
  .hero-image { object-fit: contain; padding: 24px; }
  .hero-dashboard { border: 0; }
  .is-diagram .hero-image { background: #fff; }
  /* White plots hug their own width instead of a wide white slab. */
  .is-diagram .hero-image { width: auto; max-width: 100%; margin-inline: auto; }
  .is-render .hero-image { background: #2c2c2a; }

  .project-content {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--s8) var(--s6) var(--s9);
    line-height: 1.7;
    font-size: 17px;
    color: var(--text-secondary);
    counter-reset: fig;
  }
  .project-content > :global(:first-child) { margin-top: 0; }
  .project-content :global(strong) { color: var(--text-primary); font-weight: 600; }

  .project-content :global(h2) {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--text-primary);
    margin: var(--s8) 0 var(--s4);
  }
  .project-content :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: var(--s6) 0 var(--s3);
  }
  .project-content :global(h4) {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    margin: var(--s5) 0 var(--s2);
  }
  .project-content :global(p) { margin: var(--s3) 0; }
  .project-content :global(ul), .project-content :global(ol) {
    padding-left: var(--s5);
    margin: var(--s3) 0;
  }
  .project-content :global(li) { margin: var(--s2) 0; }
  .project-content :global(blockquote) {
    border-left: 1px solid var(--text-muted);
    padding-left: var(--s5);
    margin: var(--s5) 0;
    color: var(--text-muted);
  }
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--bg-card);
    padding: 2px 5px;
    color: var(--text-primary);
  }
  .project-content :global(pre) {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--s5);
    overflow-x: auto;
    margin: var(--s5) 0;
  }
  .project-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-primary);
  }
  .project-content :global(img) {
    width: 100%;
    margin: var(--s5) 0;
  }
  .project-content :global(figure) {
    margin: var(--s6) 0 var(--s7);
    counter-increment: fig;
  }
  .project-content :global(figure img) {
    display: block;
    margin: 0;
    border: 1px solid var(--border-subtle);
  }
  .project-content :global(figure video) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 70vh;
    margin-inline: auto;
    background: #000;
    border: 1px solid var(--border-subtle);
  }
  /* Captions are numbered like figures in a report. */
  .project-content :global(figcaption) {
    margin-top: var(--s2);
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .project-content :global(figure > figcaption)::before {
    content: 'Fig. ' counter(fig);
    margin-right: var(--s2);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .project-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: var(--s5) 0;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .project-content :global(th), .project-content :global(td) {
    padding: var(--s2) var(--s3);
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .project-content :global(th) {
    color: var(--text-primary);
    font-weight: 600;
    text-align: left;
    border-top: 1px solid var(--border-subtle);
  }
  .project-content :global(tbody tr:hover) {
    background: var(--bg-card);
  }
  .project-content :global(.study-slides) {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--border-accent) var(--bg-card);
    margin: var(--s6) 0 var(--s2);
    padding-bottom: var(--s3);
  }
  .project-content :global(.study-slide) {
    box-sizing: border-box;
    flex: 0 0 100%;
    min-height: 320px;
    padding: var(--s6);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    scroll-snap-align: start;
  }
  .project-content :global(.study-slide-number) {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .12em;
  }
  .project-content :global(.study-slide h3) {
    margin: 24px 0 12px;
    font-size: clamp(23px, 3vw, 34px);
    line-height: 1.15;
  }
  .project-content :global(.study-slide p) {
    max-width: 60ch;
    margin: 12px 0;
  }
  .project-content :global(.study-slide-note) {
    color: var(--accent);
    font-size: 13px;
  }
  .project-content :global(.study-slide-metrics) {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 24px 0;
  }
  .project-content :global(.study-slide-metrics div) {
    display: grid;
    gap: 2px;
  }
  .project-content :global(.study-slide-metrics strong) {
    color: var(--text-primary);
    font-size: 31px;
    line-height: 1;
    font-weight: 500;
  }
  .project-content :global(.study-slide-metrics span) {
    color: var(--accent);
    font-size: 12px;
  }
  .project-content :global(.study-scroll-hint) {
    color: var(--text-muted);
    font-size: 12px;
    margin: 0 0 32px;
  }
  .project-content :global(iframe) {
    margin: var(--s4) 0;
  }
  .project-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: var(--s7) 0;
  }
  @media (max-width: 600px) {
    .project-hero { padding: calc(var(--nav-h) + 36px) 20px 28px; }
    .hero-title { font-size: 34px; }
    .hero-desc { font-size: 17px; }
    .hero-figure { height: 300px; padding: 0 20px; }
    .hero-image { padding: 14px; }
    .project-content { padding: var(--s7) 20px var(--s8); font-size: 16px; }
  }
</style>
<script>
  import { initHeroAnimation } from '../scripts/heroAnimations.js';

  let cancelAnim: (() => void) | null = null;

  function init() {
    if (cancelAnim) { cancelAnim(); cancelAnim = null; }
    const hero = document.querySelector('[data-animation]') as HTMLElement | null;
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (hero && canvas) {
      cancelAnim = initHeroAnimation(hero.dataset.animation!, canvas);
    }
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => {
    if (cancelAnim) { cancelAnim(); cancelAnim = null; }
  });
</script>
