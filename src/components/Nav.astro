---
interface Props { pauseAir?: boolean }
const { pauseAir = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<nav class="nav">
  <a href="/" class="nav-home" aria-label="Ethan Kong, home">
    <span class="nav-logo">
      <canvas class="nav-flow" aria-hidden="true"></canvas>
      <span class="nav-core" aria-hidden="true">EK</span>
    </span>
    <span class="nav-name">Ethan Kong</span>
  </a>
  <div class="nav-links">
    {pauseAir && <button type="button" class="pause-air" data-pause-air aria-pressed="false">Pause air</button>}
    <a href="/#projects" class="nav-link">Projects</a>
    <a href="/#classes" class="nav-link">Classes</a>
    <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
    <a href="/assets/resume.pdf" class="nav-link" target="_blank" rel="noopener">Resume</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding: 0 28px 0 12px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
  }

  .nav-home {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .nav-logo {
    position: relative;
    display: inline-block;
    width: 88px;
    height: 48px;
    flex: 0 0 88px;
  }
  .nav-flow { position: absolute; inset: 0; display: block; width: 88px; height: 48px; filter: blur(.6px); }
  .nav-core {
    position: absolute;
    left: 15px;
    top: 8px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -.03em;
  }
  .nav-name {
    margin-left: -28px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-link {
    font-size: 14px;
    color: var(--ink2);
  }
  .pause-air {
    padding: 0;
    border: 0;
    background: none;
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }
  .pause-air:hover, .pause-air[aria-pressed="true"] { color: var(--ink); }
  .nav-link:hover, .nav-link.active { color: var(--ink); }
  .nav-link.active {
    text-decoration: underline;
    text-decoration-color: var(--copper);
    text-underline-offset: 6px;
  }

  @media (max-width: 600px) {
    .nav { padding: 0 18px 0 4px; }
    .nav-name { display: none; }
    .nav-links { gap: 12px; }
    .nav-link, .pause-air { font-size: 13px; }
  }
  @media (max-width: 400px) {
    .nav { padding-right: 12px; }
    .nav-links { gap: 10px; }
  }
</style>

<script>
  import { startNavFlow } from './navFlow';

  let stopFlow: (() => void) | undefined;
  function initNavFlow() {
    stopFlow?.();
    const canvas = document.querySelector<HTMLCanvasElement>('.nav-flow');
    if (canvas) stopFlow = startNavFlow(canvas);
  }
  document.addEventListener('astro:before-swap', () => stopFlow?.());
  document.addEventListener('astro:page-load', initNavFlow);
  initNavFlow();
</script>
