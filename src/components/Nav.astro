---
interface Props {
  showBack?: boolean;
  backHref?: string;
}
const { showBack = false, backHref = '/projects' } = Astro.props;
---

<nav class="nav">
  <a href="/" class="nav-logo" aria-label="Ethan Kong — home">
    <canvas class="nav-flow" aria-hidden="true"></canvas>
    <span class="nav-core" aria-hidden="true">EK</span>
  </a>
  <div class="nav-links">
    {showBack && (
      <a href={backHref} class="nav-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back
      </a>
    )}
    <button data-open-projects class="nav-link nav-projects-btn">Projects</button>
    <a href="/assets/resume.pdf" class="nav-link nav-resume" download>Resume</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 6px 32px;
    background: rgba(18,25,27,0.96);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: var(--glass-blur);
  }

  .nav-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 48px;
    flex: 0 0 88px;
  }
  .nav-flow { position: absolute; inset: 0; display: block; width: 88px; height: 48px; filter: blur(.6px); }
  .nav-core {
    position: absolute;
    left: 15px;
    top: 8px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-base);
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.05em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link {
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text-primary); }

  .nav-projects-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .nav-resume {
    padding: 6px 16px;
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-btn);
    color: var(--accent-cyan);
    font-size: 13px;
    transition: background 0.2s;
  }
  .nav-resume:hover { background: rgba(157,185,180,0.08); }

  .nav-back {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .nav-back:hover { color: var(--accent-cyan); }
  @media (max-width: 600px) { .nav { padding: 6px 16px; } }
</style>

<script>
  import { startNavFlow } from './navFlow';

  let stopFlow: (() => void) | undefined;
  function initNavFlow() {
    stopFlow?.();
    const canvas = document.querySelector<HTMLCanvasElement>('.nav-flow');
    if (canvas) stopFlow = startNavFlow(canvas);
  }
  document.addEventListener('astro:before-swap', () => stopFlow?.());
  document.addEventListener('astro:page-load', initNavFlow);
  initNavFlow();
</script>
