---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects', ({ id }) => !id.startsWith('_'));
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const yearOf = (date?: string) => date ? new Date(`${date}T00:00:00`).getFullYear() : null;
---

<BaseLayout title="Projects · Ethan Kong">
  <main class="page">
    <h1 class="display page-title">Projects</h1>
    <p class="page-lede">Things I've built, at Stanford and before.</p>

    <ul class="grid">
      {projects.map(p => (
        <li>
          <a href={`/projects/${p.slug}`} class="card">
            <div class:list={['thumb', p.data.coverStyle && `thumb-${p.data.coverStyle}`]}>
              {p.data.coverImage
                ? <img src={p.data.coverImage} alt="" loading="lazy" decoding="async" style={p.data.coverPosition && `object-position: ${p.data.coverPosition}`} />
                : <canvas data-animation={p.data.animation} aria-hidden="true"></canvas>}
            </div>
            <div class="meta">
              <h2 class="title">{p.data.title}</h2>
              {yearOf(p.data.date) && <span class="year label">{yearOf(p.data.date)}</span>}
            </div>
            <p class="tagline">{p.data.tagline}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .grid {
    list-style: none;
    display: grid;
    /* The four main projects get large cards; the rest sit three across. */
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s7) var(--s6);
    margin-top: var(--s8);
  }
  .grid > li { grid-column: span 2; }
  .grid > li:nth-child(-n + 4) { grid-column: span 3; }
  .grid > li:nth-child(-n + 4) .title { font-size: 22px; }

  .card { display: block; }

  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-card);
    outline: 1px solid var(--border-subtle);
    outline-offset: -1px;
  }
  .thumb img, .thumb canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-diagram { background: #fff; }
  .thumb-render { background: #2c2c2a; }
  .thumb-diagram img, .thumb-render img { object-fit: contain; padding: 18px; }
  /* Hover is a hard edge and an underline, nothing that eases. */
  .card:hover .thumb { outline-color: var(--text-primary); }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    margin-top: var(--s3);
  }
  .title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .card:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .year { color: var(--text-muted); }
  .tagline {
    margin-top: var(--s1);
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid > li, .grid > li:nth-child(-n + 4) { grid-column: span 1; }
  }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; gap: var(--s7); margin-top: var(--s7); } }
</style>

<script>
  import { initHeroAnimation } from '../../scripts/heroAnimations.js';

  let stops: Array<() => void> = [];
  function init() {
    stops.forEach(stop => stop());
    stops = [];
    document.querySelectorAll<HTMLCanvasElement>('.thumb canvas[data-animation]').forEach(canvas => {
      stops.push(initHeroAnimation(canvas.dataset.animation!, canvas));
    });
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => { stops.forEach(stop => stop()); stops = []; });
</script>
