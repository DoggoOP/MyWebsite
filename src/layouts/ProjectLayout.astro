---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  date?: string;
  links?: { github?: string; paper?: string; demo?: string; };
  animation: string;
  coverImage?: string;
  order: number;
}

const { title, description, tags = [], date, links, animation, coverImage, order } = Astro.props;
const year = date ? new Date(`${date}T00:00:00`).getFullYear() : null;
---

<BaseLayout title={`${title} — Ethan Kong`} showBack={true} backHref="/">
  <header class="project-hero" data-animation={animation}>
    <div class="hero-content">
      <div class="hero-index"><span>Project log / {String(order).padStart(2, '0')}</span><span>{year}</span></div>
      <div class="hero-tags">
        {tags.slice(0, 4).map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h1 class="hero-title">{title}</h1>
      <p class="hero-desc">{description}</p>
      <div class="hero-links">
          {links?.github && (
            <a href={links.github} target="_blank" class="hero-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub
            </a>
          )}
          {links?.paper && links.paper !== "" && (
            <a href={links.paper} target="_blank" class="hero-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14,2 14,8 20,8"/>
              </svg>
              Paper
            </a>
          )}
          {links?.demo && (
            <a href={links.demo} target="_blank" class="hero-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polygon points="10,8 16,12 10,16"/>
              </svg>
              Demo
            </a>
          )}
      </div>
    </div>
    <figure class="hero-figure">
      {animation === 'polymarket'
        ? <iframe class="hero-dashboard" src="https://polymarketdashboard-production.up.railway.app/" title="Polymarket live dashboard" loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        : coverImage
          ? <img class="hero-image" src={coverImage} alt={`${title} project rendering`} />
          : <canvas id="hero-canvas" class="hero-canvas" aria-label={`${title} animated rendering`}></canvas>}
      <figcaption><span>Fig. {String(order).padStart(2, '0')} / {animation === 'polymarket' ? 'Live dashboard' : coverImage ? 'Project rendering' : 'Live study'}</span>{animation === 'polymarket' ? <a href="https://polymarketdashboard-production.up.railway.app/" target="_blank">Open dashboard ↗</a> : <span>{animation.replaceAll('-', ' ')}</span>}</figcaption>
    </figure>
  </header>

  <div class="project-body">
    <aside class="project-rail" aria-label="Project details">
      <span class="rail-label">Field notes</span>
      <span class="rail-rule"></span>
      <span class="rail-number">{String(order).padStart(2, '0')}</span>
      <span class="rail-year">{year}</span>
    </aside>
    <article class="project-content"><slot /></article>
  </div>
</BaseLayout>

<style>
  .project-hero {
    margin-top: 56px;
    min-height: 540px;
    display: grid;
    grid-template-columns: minmax(360px, 47%) minmax(0, 53%);
    background: #14242b;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(36px, 5vw, 88px);
    border-right: 1px solid var(--border-subtle);
  }

  .hero-index {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-bottom: auto;
    padding-bottom: 42px;
    color: var(--accent-cyan);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .hero-tags { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 24px; }
  .tag {
    padding: 5px 7px;
    border: 1px solid #547078;
    color: #bdd1cd;
    font-size: 10px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .hero-title {
    max-width: 660px;
    color: var(--text-primary);
    font-size: clamp(42px, 4vw, 70px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -.045em;
    margin-bottom: 26px;
  }
  .hero-desc {
    max-width: 560px;
    color: #c0cecb;
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 28px;
  }
  .hero-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; padding-top: 24px; }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid #6f9698;
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 500;
    transition: background .2s;
  }
  .hero-link:hover { background: #29434b; }

  .hero-figure {
    position: relative;
    min-width: 0;
    height: 540px;
    display: grid;
    grid-template-rows: minmax(0, 1fr) 34px;
    background: #0d191f;
  }
  .hero-figure::before, .hero-figure::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: 18px;
    height: 18px;
    pointer-events: none;
  }
  .hero-figure::before { top: 18px; left: 18px; border-top: 1px solid #9bb6b3; border-left: 1px solid #9bb6b3; }
  .hero-figure::after { right: 18px; bottom: 52px; border-right: 1px solid #9bb6b3; border-bottom: 1px solid #9bb6b3; }
  .hero-image, .hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .hero-image { object-fit: contain; padding: 30px; }
  .hero-dashboard {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    border: 0;
    background: #0d191f;
  }
  .hero-figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 17px;
    border-top: 1px solid #31444a;
    color: #a2b9b6;
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .hero-figure figcaption a { color: #c4dddd; text-decoration: underline; text-underline-offset: 2px; }

  .project-body {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(0, 780px) minmax(32px, 1fr);
    background: #101a20;
  }
  .project-rail {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 60px 30px 0 clamp(24px, 4vw, 72px);
    color: #8faeae;
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .rail-rule { width: 42px; height: 1px; background: #668c8d; }
  .rail-number { font-size: 26px; letter-spacing: -.04em; color: #c6d8d3; }
  .rail-year { color: #8faeae; }

  .project-content {
    grid-column: 2;
    min-width: 0;
    padding: 60px 32px 120px;
    line-height: 1.75;
    font-size: 16px;
    color: var(--text-secondary);
  }

  .project-content :global(h2) {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 48px 0 16px;
    letter-spacing: -0.02em;
  }
  .project-content :global(h3) {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 32px 0 12px;
  }
  .project-content :global(h4) {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 8px;
  }
  .project-content :global(p) { margin: 12px 0; }
  .project-content :global(ul), .project-content :global(ol) {
    padding-left: 24px;
    margin: 12px 0;
  }
  .project-content :global(li) { margin: 6px 0; }
  .project-content :global(blockquote) {
    border-left: 3px solid var(--accent-cyan);
    padding-left: 20px;
    margin: 20px 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background: rgba(255,255,255,0.06);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent-cyan);
  }
  .project-content :global(pre) {
    background: rgba(23,29,33,0.96);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    padding: 20px;
    overflow-x: auto;
    margin: 20px 0;
  }
  .project-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-primary);
  }
  .project-content :global(img) {
    width: 100%;
    border-radius: 2px;
    margin: 16px 0;
  }
  .project-content :global(figure) {
    margin: 28px 0 38px;
  }
  .project-content :global(figure img) {
    display: block;
    margin: 0;
    border: 1px solid var(--border-subtle);
  }
  .project-content :global(figcaption) {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .project-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 13px;
    line-height: 1.5;
  }
  .project-content :global(th), .project-content :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .project-content :global(th) {
    color: var(--text-primary);
    font-weight: 600;
    text-align: left;
    border-top: 1px solid var(--border-subtle);
  }
  .project-content :global(tbody tr:hover) {
    background: rgba(100, 156, 160, .07);
  }
  .project-content :global(.study-slides) {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: #719a99 #1b282e;
    margin: 28px 0 8px;
    padding-bottom: 12px;
  }
  .project-content :global(.study-slide) {
    box-sizing: border-box;
    flex: 0 0 100%;
    min-height: 320px;
    padding: 30px 34px;
    border: 1px solid #577779;
    background: #17252b;
    scroll-snap-align: start;
  }
  .project-content :global(.study-slide-number) {
    display: block;
    color: #9fc4c3;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .12em;
  }
  .project-content :global(.study-slide h3) {
    margin: 24px 0 12px;
    font-size: clamp(23px, 3vw, 34px);
    line-height: 1.15;
  }
  .project-content :global(.study-slide p) {
    max-width: 60ch;
    margin: 12px 0;
  }
  .project-content :global(.study-slide-note) {
    color: #9fc4c3;
    font-size: 13px;
  }
  .project-content :global(.study-slide-metrics) {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 24px 0;
  }
  .project-content :global(.study-slide-metrics div) {
    display: grid;
    gap: 2px;
  }
  .project-content :global(.study-slide-metrics strong) {
    color: #dbe9e3;
    font-size: 31px;
    line-height: 1;
    font-weight: 500;
  }
  .project-content :global(.study-slide-metrics span) {
    color: #9fc4c3;
    font-size: 12px;
  }
  .project-content :global(.study-scroll-hint) {
    color: var(--text-muted);
    font-size: 12px;
    margin: 0 0 32px;
  }
  .project-content :global(iframe) {
    border-radius: 2px;
    margin: 16px 0;
  }
  .project-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 40px 0;
  }
  .project-content :global(a) {
    color: var(--accent-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
    .project-hero { grid-template-columns: 1fr; }
    .hero-content { min-height: 420px; border-right: 0; border-bottom: 1px solid var(--border-subtle); }
    .hero-figure { height: 360px; }
    .project-body { grid-template-columns: 1fr; }
    .project-rail { display: none; }
    .project-content { grid-column: 1; }
  }
  @media (max-width: 600px) {
    .hero-content { padding: 30px 24px; }
    .hero-title { font-size: 40px; }
    .hero-figure { height: 300px; }
    .hero-image { padding: 18px; }
    .project-content { padding: 36px 24px 90px; }
  }
</style>

<script>
  import { initHeroAnimation } from '../scripts/heroAnimations.js';

  let cancelAnim: (() => void) | null = null;

  function init() {
    if (cancelAnim) { cancelAnim(); cancelAnim = null; }
    const hero = document.querySelector('[data-animation]') as HTMLElement | null;
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (hero && canvas) {
      cancelAnim = initHeroAnimation(hero.dataset.animation!, canvas);
    }
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => {
    if (cancelAnim) { cancelAnim(); cancelAnim = null; }
  });
</script>
