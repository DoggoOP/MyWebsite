---
import BaseLayout from './BaseLayout.astro';

interface Neighbour { slug: string; title: string; }
interface Props {
  title: string;
  description: string;
  tags?: string[];
  date?: string;
  links?: { github?: string; paper?: string; demo?: string; };
  animation: string;
  coverImage?: string;
  coverStyle?: 'photo' | 'diagram' | 'render';
  prev?: Neighbour;
  next?: Neighbour;
}

const { title, description, tags = [], date, links, animation, coverImage, coverStyle, prev, next } = Astro.props;
const year = date ? new Date(`${date}T00:00:00`).getFullYear() : null;
const linkList = [
  links?.github && { href: links.github, label: 'GitHub' },
  links?.paper && { href: links.paper, label: 'Paper' },
  links?.demo && { href: links.demo, label: animation === 'polymarket' ? 'Live dashboard' : 'Demo' },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout title={`${title} · Ethan Kong`} description={description} math={true}>
  <main class="col project">
    <header class="head">
      <a href="/#projects" class="back">← All projects</a>
      <h1 class="title">{title}</h1>
      <p class="lede">{description}</p>
      {(year || linkList.length > 0) && (
        <p class="meta">
          {year && <span>{year}</span>}
          {linkList.map(l => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </p>
      )}
    </header>

    {(animation === 'polymarket' || coverImage) && (
      <figure class:list={['cover', coverStyle && `is-${coverStyle}`]}>
        {animation === 'polymarket'
          ? <iframe class="cover-dashboard" src="https://polymarketdashboard-production.up.railway.app/" title="Polymarket live dashboard" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          : <img class="cover-image" src={coverImage} alt={title} />}
      </figure>
    )}

    <div class="body">
      <aside class="aside" aria-label="Project details">
        <dl>
          {year && <><dt>Year</dt><dd>{year}</dd></>}
          {tags.length > 0 && <><dt>Tools</dt><dd>{tags.join(', ')}</dd></>}
        </dl>
      </aside>
      <article class="project-content prose"><slot /></article>
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="More projects">
        {prev ? <a class="pager-link" href={`/projects/${prev.slug}`}><span class="pager-label">Previous</span><span class="pager-title">{prev.title}</span></a> : <span></span>}
        {next ? <a class="pager-link pager-next" href={`/projects/${next.slug}`}><span class="pager-label">Next</span><span class="pager-title">{next.title}</span></a> : <span></span>}
      </nav>
    )}
  </main>
</BaseLayout>

<style>
  .col {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding-inline: 40px;
  }
  .project {
    padding-top: calc(var(--nav-h) + 56px);
    padding-bottom: 120px;
  }
  .head { max-width: 760px; }
  .back {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--ink2);
    font-size: 14px;
  }
  .back:hover { color: var(--copper); }
  .title {
    font-size: 56px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--ink);
    margin-bottom: 20px;
    text-wrap: balance;
  }
  .lede {
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink2);
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 24px;
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .meta a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .meta a:hover { color: var(--copper); text-decoration-color: var(--copper); }

  .cover {
    margin-top: 48px;
    padding: 24px;
    background: var(--scanbg);
    outline: 1px solid var(--rule);
    outline-offset: -1px;
  }
  .cover-image {
    display: block;
    width: 100%;
    max-height: 640px;
    object-fit: contain;
    margin-inline: auto;
  }
  .cover:not(.is-diagram):not(.is-render) { padding: 0; }
  .cover.is-diagram { background: #fff; }
  .cover.is-render { background: #2c2c2a; }
  .cover:has(.cover-dashboard) { padding: 0; }
  .cover-dashboard {
    display: block;
    width: 100%;
    height: min(70vh, 640px);
    border: 0;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 680px) minmax(0, 240px);
    justify-content: space-between;
    gap: 64px;
    margin-top: 72px;
  }
  .aside {
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .aside dl {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 10px 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .aside dt { color: var(--muted); }
  .aside dd { color: var(--ink); }

  .project-content {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink2);
    counter-reset: fig;
  }
  .project-content > :global(:first-child) { margin-top: 0; }
  .project-content :global(strong) { color: var(--ink); font-weight: 600; }

  .project-content :global(h2) {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ink);
    margin: 72px 0 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .project-content :global(h3) {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: var(--s6) 0 var(--s3);
  }
  .project-content :global(h4) {
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    margin: var(--s5) 0 var(--s2);
  }
  .project-content :global(p) { margin: var(--s3) 0; }
  .project-content :global(ul), .project-content :global(ol) {
    padding-left: var(--s5);
    margin: var(--s3) 0;
  }
  .project-content :global(li) { margin: var(--s2) 0; }
  .project-content :global(blockquote) {
    border-left: 1px solid var(--muted);
    padding-left: var(--s5);
    margin: var(--s5) 0;
    color: var(--muted);
  }
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--scanbg);
    padding: 2px 5px;
    color: var(--ink);
  }
  .project-content :global(pre) {
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: var(--s5);
    overflow-x: auto;
    margin: var(--s5) 0;
  }
  .project-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--ink);
  }
  .project-content :global(img) {
    width: 100%;
    margin: var(--s5) 0;
  }
  .project-content :global(figure) {
    margin: var(--s6) 0 var(--s7);
    counter-increment: fig;
  }
  .project-content :global(figure img) {
    display: block;
    margin: 0;
    border: 1px solid var(--rule);
  }
  .project-content :global(figure video) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 70vh;
    margin-inline: auto;
    background: var(--scanbg);
    border: 1px solid var(--rule);
  }
  .project-content :global(figcaption) {
    margin-top: var(--s2);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .project-content :global(figure > figcaption)::before {
    content: 'Fig. ' counter(fig);
    margin-right: var(--s2);
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
  }
  .project-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: var(--s5) 0;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .project-content :global(th), .project-content :global(td) {
    padding: var(--s2) var(--s3);
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  .project-content :global(th) {
    color: var(--ink);
    font-weight: 600;
    text-align: left;
    border-top: 1px solid var(--rule);
  }
  .project-content :global(tbody tr:hover) {
    background: var(--scanbg);
  }
  .project-content :global(.study-slides) {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--muted) var(--scanbg);
    margin: var(--s6) 0 var(--s2);
    padding-bottom: var(--s3);
  }
  .project-content :global(.study-slide) {
    box-sizing: border-box;
    flex: 0 0 100%;
    min-height: 320px;
    padding: var(--s6);
    border: 1px solid var(--rule);
    background: var(--scanbg);
    scroll-snap-align: start;
  }
  .project-content :global(.study-slide-number) {
    display: block;
    color: var(--copper);
    font-size: 12px;
    letter-spacing: .08em;
    font-variant-numeric: tabular-nums;
  }
  .project-content :global(.study-slide h3) {
    margin: 24px 0 12px;
    font-size: clamp(23px, 3vw, 34px);
    line-height: 1.15;
  }
  .project-content :global(.study-slide p) {
    max-width: 60ch;
    margin: 12px 0;
  }
  .project-content :global(.study-slide-note) {
    color: var(--copper);
    font-size: 13px;
  }
  .project-content :global(.study-slide-metrics) {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 24px 0;
  }
  .project-content :global(.study-slide-metrics div) {
    display: grid;
    gap: 2px;
  }
  .project-content :global(.study-slide-metrics strong) {
    color: var(--ink);
    font-size: 31px;
    line-height: 1;
    font-weight: 500;
  }
  .project-content :global(.study-slide-metrics span) {
    color: var(--copper);
    font-size: 12px;
  }
  .project-content :global(.study-scroll-hint) {
    color: var(--muted);
    font-size: 12px;
    margin: 0 0 32px;
  }
  .project-content :global(iframe) {
    margin: var(--s4) 0;
  }
  .project-content :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: var(--s7) 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .pager-link { display: block; }
  .pager-next { text-align: right; grid-column: 2; }
  .pager-label { display: block; font-size: 13px; color: var(--muted); }
  .pager-title {
    display: block;
    margin-top: 4px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--ink);
  }
  .pager-link:hover .pager-title {
    text-decoration: underline;
    text-decoration-color: var(--copper);
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .title { font-size: 44px; }
    .body { grid-template-columns: minmax(0, 1fr); gap: 40px; margin-top: 56px; }
    .aside { grid-column: 1; grid-row: 1; position: static; max-width: 680px; }
    .project-content { grid-column: 1; grid-row: 2; }
  }
  @media (max-width: 600px) {
    .col { padding-inline: 20px; }
    .project { padding-top: calc(var(--nav-h) + 36px); padding-bottom: 72px; }
    .title { font-size: 36px; }
    .lede { font-size: 18px; }
    .cover { margin-top: 32px; padding: 14px; }
    .project-content { font-size: 16px; }
    .project-content :global(h2) { font-size: 28px; margin-top: 56px; }
    .pager { gap: 20px; margin-top: 64px; }
    .pager-title { font-size: 17px; }
  }
</style>
