---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  math?: boolean;
  noNav?: boolean;
}

const {
  title = 'Ethan Kong',
  description = 'Ethan Kong studies aerospace engineering at Stanford and builds across physics, hardware and software.',
  math = false,
  noNav = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/ek-vorticity.png" />
    <link rel="apple-touch-icon" href="/assets/ek-vorticity.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    {math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
    <ViewTransitions />
  </head>
  <body>
    {!noNav && <Nav />}
    <slot />
  </body>
</html>

<style is:global>
  @keyframes page-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes page-fade-out { from { opacity: 1; } to { opacity: 0; } }
  ::view-transition-old(root) { animation: 180ms ease-out page-fade-out; }
  ::view-transition-new(root) { animation: 240ms ease-in page-fade-in; }
</style>
