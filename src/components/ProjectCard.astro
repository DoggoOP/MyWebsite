---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project: p, featured = false } = Astro.props;
const year = p.data.date ? new Date(`${p.data.date}T00:00:00`).getFullYear() : null;
---

<a href={`/projects/${p.slug}`} class:list={['card', { featured }]}>
  <div class:list={['thumb', p.data.coverStyle && `thumb-${p.data.coverStyle}`]}>
    {p.data.coverImage
      ? <img src={p.data.coverImage} alt="" loading="lazy" decoding="async" style={p.data.coverPosition && `object-position: ${p.data.coverPosition}`} />
      : <canvas data-animation={p.data.animation} aria-hidden="true"></canvas>}
  </div>
  <div class="meta">
    <h3 class="title">{p.data.title}</h3>
    {year && <span class="year">{year}</span>}
  </div>
  <p class="tagline">{p.data.tagline}</p>
</a>

<style>
  .card { display: block; }

  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--scanbg);
    outline: 1px solid var(--rule);
    outline-offset: -1px;
  }
  .featured .thumb { aspect-ratio: 16 / 10; }
  .thumb img, .thumb canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-diagram { background: #fff; }
  .thumb-render { background: #2c2c2a; }
  .thumb-diagram img, .thumb-render img { object-fit: contain; padding: 16px; }
  .card:hover .thumb { outline-color: var(--ink); }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }
  .title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--ink);
  }
  .featured .title { font-size: 22px; letter-spacing: -0.015em; }
  .card:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--copper);
    text-underline-offset: 4px;
  }
  .year {
    flex: none;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .tagline {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink2);
  }
</style>
