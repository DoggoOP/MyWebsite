---
import BaseLayout from '../layouts/BaseLayout.astro';
import PointCloudViewer from '../components/PointCloudViewer.tsx';
---

<BaseLayout title="Ethan Kong">
  <div id="hero-load-status" class="hero-load-status" role="status" aria-live="polite">
    <progress id="hero-load-progress" value="0" max="100" aria-label="3D scan loading progress"></progress>
    <span class="visually-hidden">Loading 3D scan <span id="hero-load-percent">0%</span></span>
  </div>
  <canvas id="flow-canvas" class="flow-canvas" aria-hidden="true"></canvas>
  <main class="landing">
    <section class="landing-viewer" aria-label="3D scan of Ethan in a simulated wind tunnel">
      <PointCloudViewer src="/assets/3dImage-home.lssnap" axesSrc="/assets/3dImage-home-surfels.bin" filter={false} airflow={true} client:only="react" />
    </section>

    <section class="landing-bio">
      <!-- The circle is also the cylinder the sim's air flows around. -->
      <div class="bio" id="bio-card">
        <div class="bio-inner">
          <h1 class="bio-name">Hi, I'm Ethan</h1>
          <div class="prose bio-text">
            <p>
              I grew up in Hong Kong and chose to study Aero/Astro at Stanford because
              no other engineering field requires as many disciplines<span class="wide-only">. Getting
              anything to fly takes fluids, structures, controls, electronics and code</span>.<span class="wide-only">
              I'm building <a href="/projects/lattice">Lattice</a>, 3D capture for robotics,
              and work with the <a href="/projects/solar-car">Solar Car Project</a> and the
              <a href="/projects/ion-thruster">Plasma Physics Lab</a>.</span>
            </p>
            <p>
              I <a class="peek" href="/about#sailing">sailed for the national team<span class="peek-card" aria-hidden="true"><img src="/assets/about/peek-sailing.jpg" alt="" width="480" height="311" /></span></a>
              growing up, which is how I got into fluid dynamics. The air here is a
              <span class="nowrap">lattice-Boltzmann</span> sim<span class="wide-only">, the
              same method I first used <a href="/projects/sailing-rl">to model a sail</a></span>.
              <span class="wide-only">When I'm not sailing, I'm probably
              <a class="peek" href="/about#ceramics">making pottery<span class="peek-card" aria-hidden="true"><img src="/assets/about/peek-pottery.jpg" alt="" width="480" height="313" /></span></a>.</span>
            </p>
          </div>
          <nav class="bio-links" aria-label="Contact">
            <a class="text-link" href="mailto:ethank07@stanford.edu">Email</a>
            <a class="text-link" href="https://github.com/DoggoOP" target="_blank" rel="noopener">GitHub</a>
            <a class="text-link" href="https://www.linkedin.com/in/ethank07/" target="_blank" rel="noopener">LinkedIn</a>
            <a class="text-link" href="/assets/resume.pdf" target="_blank" rel="noopener">Resume</a>
          </nav>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .hero-load-status {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    z-index: 90;
    height: 2px;
    pointer-events: none;
  }
  .hero-load-status progress {
    display: block;
    width: 100%;
    height: 2px;
    appearance: none;
    border: 0;
    background: transparent;
  }
  .hero-load-status progress::-webkit-progress-bar { background: transparent; }
  .hero-load-status progress::-webkit-progress-value { background: var(--accent); transition: width .2s; }
  .hero-load-status progress::-moz-progress-bar { background: var(--accent); }

  .flow-canvas {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .landing {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100vh;
    height: 100dvh;
    padding-top: var(--nav-h);
    pointer-events: none;
  }

  .landing-viewer {
    flex: 1;
    height: 100%;
    position: relative;
    z-index: 3;
    pointer-events: auto;
    order: 1;
  }

  .landing-bio {
    flex: 0 0 50%;
    display: flex;
    position: relative;
    z-index: 3;
    align-items: center;
    justify-content: flex-end;
    padding: 32px 0 32px 48px;
    order: 0;
  }

  /* Everything inside scales with the circle, so the text always fits it. */
  .bio {
    container: bio / inline-size;
    display: grid;
    place-items: center;
    width: min(580px, 44vw, calc(100dvh - var(--nav-h) - 64px));
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bg-base);
    text-align: center;
    pointer-events: auto;
  }
  .bio-inner { width: 72%; }

  .bio-name {
    font-size: clamp(18px, 4.4cqi, 26px);
    letter-spacing: -0.015em;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-primary);
    margin-bottom: 3.6cqi;
  }

  .bio-text p {
    font-size: clamp(12.5px, 2.6cqi, 15.5px);
    line-height: 1.65;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* Hover previews for the personal lines. */
  .peek { position: relative; }
  .peek-card {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 12px);
    z-index: 5;
    width: 220px;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, .45);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    pointer-events: none;
  }
  .peek-card img { display: block; width: 100%; height: auto; }
  .peek:hover .peek-card, .peek:focus-visible .peek-card {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  @media (hover: none) { .peek-card { display: none; } }

  .bio-text p + p { margin-top: 2.4cqi; }
  .nowrap { white-space: nowrap; }

  .bio-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4cqi;
    margin-top: 4.5cqi;
    font-size: clamp(12px, 2.3cqi, 14px);
  }

  /* A small circle keeps only the core sentences. */
  @container bio (max-width: 500px) {
    .wide-only { display: none; }
    .bio-inner { width: 76%; }
  }

  @media (max-width: 900px) {
    .landing { flex-direction: column; height: auto; min-height: 100vh; }
    .landing-viewer { order: 1; flex: 0 0 52vh; width: 100%; }
    .landing-bio { order: 0; flex: 0 0 auto; justify-content: center; padding: 16px 16px 0; }
    .bio { width: min(calc(100vw - 32px), 520px); }
  }
</style>
