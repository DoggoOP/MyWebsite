---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('projects', ({ id }) => !id.startsWith('_'));
  const projects = all.sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => {
    const prev = projects[(i - 1 + projects.length) % projects.length];
    const next = projects[(i + 1) % projects.length];
    return {
      params: { slug: project.slug },
      props: {
        project,
        prev: { slug: prev.slug, title: prev.data.title },
        next: { slug: next.slug, title: next.data.title },
      },
    };
  });
}

const { project, prev, next } = Astro.props;
const { Content } = await project.render();
const { title, description, tags, date, links, animation, coverImage, coverStyle } = project.data;
---

<ProjectLayout
  title={title}
  description={description}
  tags={tags}
  date={date}
  links={links}
  animation={animation}
  coverImage={coverImage}
  coverStyle={coverStyle}
  prev={prev}
  next={next}
>
  <Content />
</ProjectLayout>
