<div class="sail-video" data-sail-video>
  <video
    src="/assets/solar-sail-camber.mp4"
    controls
    playsinline
    preload="metadata"
    poster="/assets/solar-sail-camber-poster.jpg"
    aria-label="Physical sail prototype changing camber"
  ></video>
  <button class="sail-video-play" type="button" aria-label="Play sail camber video">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
    Play camber demo
  </button>
</div>

<style>
  .sail-video { position: relative; width: fit-content; max-width: 100%; margin-inline: auto; }
  .sail-video video { display: block; width: auto; height: auto; max-width: 100%; max-height: 70vh; background: #0d191f; border: 1px solid var(--border-subtle); }
  .sail-video-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 7px;
    padding: 9px 13px;
    border: 1px solid var(--border-accent);
    background: rgba(18, 25, 27, .94);
    color: var(--text-primary);
    font-size: 12px;
    white-space: nowrap;
  }
  .sail-video-play[hidden] { display: none; }
  .sail-video-play svg { width: 16px; height: 16px; fill: currentColor; }
</style>

<script>
  function initSailVideos() {
    document.querySelectorAll<HTMLElement>('[data-sail-video]').forEach(shell => {
      if (shell.dataset.ready) return;
      shell.dataset.ready = 'true';
      const video = shell.querySelector('video');
      const button = shell.querySelector<HTMLButtonElement>('.sail-video-play');
      if (!video || !button) return;
      button.addEventListener('click', () => { void video.play(); });
      video.addEventListener('play', () => { button.hidden = true; });
      video.addEventListener('pause', () => { button.hidden = false; });
      video.addEventListener('ended', () => { button.hidden = false; });
    });
  }
  document.addEventListener('astro:page-load', initSailVideos);
  initSailVideos();
</script>
