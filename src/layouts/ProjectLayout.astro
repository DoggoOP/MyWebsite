---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  date?: string;
  links?: { github?: string; paper?: string; demo?: string; };
  animation: string;
  coverImage?: string;
  coverStyle?: 'photo' | 'diagram';
}

const { title, description, tags = [], date, links, animation, coverImage, coverStyle } = Astro.props;
const year = date ? new Date(`${date}T00:00:00`).getFullYear() : null;
const linkList = [
  links?.github && { href: links.github, label: 'GitHub' },
  links?.paper && { href: links.paper, label: 'Paper' },
  links?.demo && { href: links.demo, label: animation === 'polymarket' ? 'Live dashboard' : 'Demo' },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout title={`${title} · Ethan Kong`} description={description} math={true}>
  <header class="project-hero" data-animation={animation}>
    <a href="/projects" class="back text-link">Projects</a>
    <h1 class="display hero-title">{title}</h1>
    <p class="hero-desc">{description}</p>
    <p class="hero-meta">
      {year && <span>{year}</span>}
      {tags.length > 0 && <span>{tags.slice(0, 4).join(', ')}</span>}
      {linkList.map(l => <a class="text-link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
    </p>
  </header>

  <figure class:list={['hero-figure', coverStyle && `is-${coverStyle}`]}>
    {animation === 'polymarket'
      ? <iframe class="hero-dashboard" src="https://polymarketdashboard-production.up.railway.app/" title="Polymarket live dashboard" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      : animation === 'ar-go-kart'
        ? <picture class="hero-picture">
            <source media="(max-width: 600px)" srcset="/assets/ar-go-kart-system-mobile.svg" />
            <img class="hero-image" src={coverImage} alt="Augmented reality go-kart system schematic" />
          </picture>
      : coverImage
        ? <img class="hero-image" src={coverImage} alt={`${title}`} />
        : <canvas id="hero-canvas" class="hero-canvas" aria-label={`${title} animated rendering`}></canvas>}
  </figure>

  <article class="project-content prose"><slot /></article>
</BaseLayout>

<style>
  .project-hero {
    max-width: 760px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 64px) 32px 40px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--text-muted) !important;
    font-size: 14px;
  }
  .back::before { content: '← '; }
  .hero-title {
    font-size: 32px;
    margin-bottom: 14px;
  }
  .hero-desc {
    color: var(--text-secondary);
    font-size: 18px;
    line-height: 1.6;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 22px;
    color: var(--text-muted);
    font-size: 14px;
  }

  .hero-figure {
    max-width: 1080px;
    height: min(62vh, 600px);
    margin: 16px auto 0;
    padding: 0 32px;
  }
  .hero-image, .hero-canvas, .hero-dashboard, .hero-picture {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-card);
    background: var(--bg-card);
  }
  .hero-image { object-fit: contain; padding: 24px; }
  .hero-dashboard { border: 0; }
  .is-diagram .hero-image, .is-diagram .hero-picture { background: #fff; }
  /* White plots hug their own width instead of a wide white slab. */
  .is-diagram .hero-image { width: auto; max-width: 100%; margin-inline: auto; }
  .is-render .hero-image { background: #2e3440; }
  .hero-picture .hero-image { background: transparent; }

  .project-content {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 32px 120px;
    line-height: 1.75;
    font-size: 16px;
    color: var(--text-secondary);
  }

  .project-content :global(h2) {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text-primary);
    margin: 56px 0 14px;
  }
  .project-content :global(h3) {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 32px 0 12px;
  }
  .project-content :global(h4) {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 8px;
  }
  .project-content :global(p) { margin: 12px 0; }
  .project-content :global(ul), .project-content :global(ol) {
    padding-left: 24px;
    margin: 12px 0;
  }
  .project-content :global(li) { margin: 6px 0; }
  .project-content :global(blockquote) {
    border-left: 3px solid var(--accent-cyan);
    padding-left: 20px;
    margin: 20px 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background: rgba(255,255,255,0.06);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent-cyan);
  }
  .project-content :global(pre) {
    background: rgba(23,29,33,0.96);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    padding: 20px;
    overflow-x: auto;
    margin: 20px 0;
  }
  .project-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-primary);
  }
  .project-content :global(img) {
    width: 100%;
    border-radius: var(--radius-card);
    margin: 20px 0;
  }
  .project-content :global(figure) {
    margin: 28px 0 38px;
  }
  .project-content :global(figure img) {
    display: block;
    margin: 0;
    border: 1px solid var(--border-subtle);
  }
  .project-content :global(figure video) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 70vh;
    margin-inline: auto;
    background: #0d191f;
    border: 1px solid var(--border-subtle);
  }
  .project-content :global(figcaption) {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .project-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 13px;
    line-height: 1.5;
  }
  .project-content :global(th), .project-content :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .project-content :global(th) {
    color: var(--text-primary);
    font-weight: 600;
    text-align: left;
    border-top: 1px solid var(--border-subtle);
  }
  .project-content :global(tbody tr:hover) {
    background: rgba(100, 156, 160, .07);
  }
  .project-content :global(.study-slides) {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--border-accent) var(--bg-card);
    margin: 28px 0 8px;
    padding-bottom: 12px;
  }
  .project-content :global(.study-slide) {
    box-sizing: border-box;
    flex: 0 0 100%;
    min-height: 320px;
    padding: 30px 34px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    border-radius: var(--radius-card);
    scroll-snap-align: start;
  }
  .project-content :global(.study-slide-number) {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .12em;
  }
  .project-content :global(.study-slide h3) {
    margin: 24px 0 12px;
    font-size: clamp(23px, 3vw, 34px);
    line-height: 1.15;
  }
  .project-content :global(.study-slide p) {
    max-width: 60ch;
    margin: 12px 0;
  }
  .project-content :global(.study-slide-note) {
    color: var(--accent);
    font-size: 13px;
  }
  .project-content :global(.study-slide-metrics) {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 24px 0;
  }
  .project-content :global(.study-slide-metrics div) {
    display: grid;
    gap: 2px;
  }
  .project-content :global(.study-slide-metrics strong) {
    color: var(--text-primary);
    font-size: 31px;
    line-height: 1;
    font-weight: 500;
  }
  .project-content :global(.study-slide-metrics span) {
    color: var(--accent);
    font-size: 12px;
  }
  .project-content :global(.study-scroll-hint) {
    color: var(--text-muted);
    font-size: 12px;
    margin: 0 0 32px;
  }
  .project-content :global(iframe) {
    border-radius: 2px;
    margin: 16px 0;
  }
  .project-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 40px 0;
  }
  @media (max-width: 600px) {
    .project-hero { padding: calc(var(--nav-h) + 36px) 20px 28px; }
    .hero-desc { font-size: 16px; }
    .hero-figure { height: 300px; padding: 0 20px; }
    .hero-figure:has(.hero-picture) { height: 730px; }
    .hero-image { padding: 14px; }
    .project-content { padding: 40px 20px 90px; }
  }
</style>
<script>
  import { initHeroAnimation } from '../scripts/heroAnimations.js';

  let cancelAnim: (() => void) | null = null;

  function init() {
    if (cancelAnim) { cancelAnim(); cancelAnim = null; }
    const hero = document.querySelector('[data-animation]') as HTMLElement | null;
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (hero && canvas) {
      cancelAnim = initHeroAnimation(hero.dataset.animation!, canvas);
    }
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => {
    if (cancelAnim) { cancelAnim(); cancelAnim = null; }
  });
</script>
