---
interface Props { class?: string }
const { class: className } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', className]}>
  <div class="footer">
    <nav class="footer-links" aria-label="Footer contact">
      <a class="text-link" href="mailto:ethank07@stanford.edu">Email</a>
      <a class="text-link" href="https://github.com/DoggoOP" target="_blank" rel="noopener">GitHub</a>
      <a class="text-link" href="https://www.linkedin.com/in/ethank07/" target="_blank" rel="noopener">LinkedIn</a>
      <a class="text-link" href="/assets/resume.pdf" target="_blank" rel="noopener">Resume</a>
    </nav>
    <p class="copyright">© {year} Ethan Kong</p>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 40px;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 24px;
    padding-top: 28px;
    padding-bottom: 56px;
    border-top: 1px solid var(--rule);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 15px;
  }
  .copyright { font-size: 13px; color: var(--muted); }

  @media (max-width: 600px) {
    .site-footer { padding-inline: 20px; }
  }
</style>
