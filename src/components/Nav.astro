---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<nav class="nav">
  <a href="/" class="nav-home" aria-label="Ethan Kong, home">
    <span class="nav-logo">
      <canvas class="nav-flow" aria-hidden="true"></canvas>
      <span class="nav-core" aria-hidden="true">EK</span>
    </span>
    <span class="nav-name">Ethan Kong</span>
  </a>
  <div class="nav-links">
    <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
    <a href="/projects" class:list={['nav-link', { active: isActive('/projects') }]}>Projects</a>
    <a href="/assets/resume.pdf" class="nav-link" target="_blank" rel="noopener">Resume</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding: 0 28px 0 12px;
    background: rgba(15, 19, 20, 0.92);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-home {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .nav-logo {
    position: relative;
    display: inline-block;
    width: 88px;
    height: 48px;
    flex: 0 0 88px;
  }
  .nav-flow { position: absolute; inset: 0; display: block; width: 88px; height: 48px; filter: blur(.6px); }
  .nav-core {
    position: absolute;
    left: 15px;
    top: 8px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-base);
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -.03em;
  }
  .nav-name {
    margin-left: -28px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-link {
    font-size: 14px;
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .nav-link:hover, .nav-link.active { color: var(--text-primary); }
  .nav-link.active {
    text-decoration: underline;
    text-decoration-color: var(--border-accent);
    text-underline-offset: 6px;
  }

  @media (max-width: 600px) {
    .nav { padding: 0 18px 0 4px; }
    .nav-name { display: none; }
    .nav-links { gap: 20px; }
  }
</style>

<script>
  import { startNavFlow } from './navFlow';

  let stopFlow: (() => void) | undefined;
  function initNavFlow() {
    stopFlow?.();
    const canvas = document.querySelector<HTMLCanvasElement>('.nav-flow');
    if (canvas) stopFlow = startNavFlow(canvas);
  }
  document.addEventListener('astro:before-swap', () => stopFlow?.());
  document.addEventListener('astro:page-load', initNavFlow);
  initNavFlow();
</script>
